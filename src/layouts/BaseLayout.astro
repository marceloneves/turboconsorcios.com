---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappBar from '../components/WhatsappBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /* false = noindex (páginas que ainda não cumprem a condição de publicação da planilha) */
  indexar?: boolean;
}
const { title, description, canonical, indexar = true } = Astro.props;
const href = new URL(canonical ?? Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />
    {!indexar && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={href} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#102a43" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Saira:wght@500;600;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="antialiased">
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsappBar />
  </body>
</html>
