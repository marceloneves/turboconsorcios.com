---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqLista from '../../components/FaqLista.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import Icon from '../../components/Icon.astro';
import { estados } from '../../data/estados';
import { consorciosDestaque } from '../../data/consorcios';
import { faq } from '../../data/faq';
import { site } from '../../data/site';

export function getStaticPaths() {
  return estados.map((e) => ({ params: { estado: e.slug }, props: { e } }));
}

const { e } = Astro.props;
const titulo = `Consórcio em ${e.nome} Sem Juros. Simule Grátis Agora`;
const descricao = `Consórcio em ${e.nome} (${e.uf}) sem juros e sem entrada. Imóveis, veículos, motos, caminhões e serviços em todas as cidades do estado. Simule grátis.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Consórcio em ${e.nome}`,
  description: descricao,
  provider: { '@type': 'Organization', name: site.nome, url: site.url },
  areaServed: { '@type': 'State', name: e.nome },
};
---

<BaseLayout title={`${titulo} | ${site.nome}`} description={descricao}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <PageHero
    label={`${e.regiao} · ${e.uf}`}
    titulo={`Consórcio em ${e.nome} Sem Juros e Sem Entrada`}
    texto={`Atendemos todas as cidades de ${e.nome} com 37 administradoras parceiras. Imóveis, veículos, motos, caminhões, máquinas agrícolas e serviços — sem juros bancários.`}
    imagem="/images/brazil-city.webp"
    cta={`Simular Consórcio em ${e.nome}`}
    trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Localidades', href: '/localidades' }, { rotulo: e.nome }]}
  />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="section-label">Consórcio em {e.nome}</p>
          <h2 class="font-heading font-bold text-3xl text-primary-900 mb-6">
            Como funciona o consórcio para quem mora em {e.nome}
          </h2>
          <div class="space-y-5 text-primary-700 leading-relaxed">
            <p>
              O atendimento em {e.nome} é feito de forma 100% digital: você faz a simulação, recebe o comparativo de
              planos e assina o contrato sem sair de casa. Toda a operação segue a Lei 11.795/2008 e é fiscalizada pelo
              Banco Central.
            </p>
            <p>
              Trabalhamos com {e.cidades.length === 1 ? 'a capital e o interior' : 'as principais cidades e o interior'} do
              estado, oferecendo cartas de crédito para imóveis, veículos, motos, caminhões, máquinas agrícolas,
              embarcações e serviços.
            </p>
            <p>
              Como não há juros, a parcela é significativamente menor que a de um financiamento equivalente — e a carta
              de crédito dá poder de compra à vista na hora de negociar.
            </p>
          </div>
        </div>
        <div class="bg-primary-50 border border-primary-100 p-8">
          <h3 class="font-heading font-bold text-xl text-primary-900 mb-6 flex items-center gap-3">
            <Icon name="mapPin" class="w-5 h-5 text-accent" />Cidades atendidas em {e.nome}
          </h3>
          <ul class="grid grid-cols-2 gap-x-6 gap-y-3 list-none p-0">
            {
              e.cidades.map((cid) => (
                <li>
                  <a
                    class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                    href={`/consorcio-em-${e.slug}/${cid.slug}`}
                  >
                    {cid.nome}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="text-primary-600 text-xs mt-6 leading-relaxed">
            Não encontrou sua cidade? Atendemos todos os municípios de {e.nome} — fale com um especialista.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-primary-50">
    <div class="max-w-7xl mx-auto px-6">
      <p class="section-label">Modalidades</p>
      <h2 class="font-heading font-bold text-3xl text-primary-900 mb-12">Tipos de consórcio disponíveis em {e.nome}</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-px bg-primary-200 list-none p-0 m-0">
        {
          consorciosDestaque.map((c) => (
            <li class="bg-white">
              <a class="group block p-8 h-full transition-colors duration-500 hover:bg-primary-900" href={`/${c.slug}`}>
                <span class="w-12 h-12 border border-primary-200 flex items-center justify-center mb-5 transition-all duration-500 group-hover:bg-accent group-hover:border-accent">
                  <Icon name={c.icone} class="w-5 h-5 text-primary-900 transition-colors duration-500 group-hover:text-white" />
                </span>
                <h3 class="font-heading text-xl font-bold text-primary-900 mb-2 group-hover:text-white transition-colors duration-300">
                  {c.nome}
                </h3>
                <p class="text-primary-700 text-sm leading-relaxed group-hover:text-white transition-colors duration-300">
                  {c.resumo}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqLista perguntas={faq} titulo={`Dúvidas sobre consórcio em ${e.nome}`} />
  <CtaFinal
    titulo={`Simule seu consórcio em ${e.nome}`}
    texto={`Sem juros, sem entrada obrigatória e com atendimento em todas as cidades de ${e.nome}.`}
  />
</BaseLayout>
