---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqLista from '../../components/FaqLista.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import Icon from '../../components/Icon.astro';
import { estados } from '../../data/estados';
import { consorciosDestaque } from '../../data/consorcios';
import { faq } from '../../data/faq';
import { site } from '../../data/site';

export function getStaticPaths() {
  return estados.flatMap((e) =>
    e.cidades.map((cid) => ({ params: { estado: e.slug, cidade: cid.slug }, props: { e, cid } }))
  );
}

const { e, cid } = Astro.props;
const outras = e.cidades.filter((o) => o.slug !== cid.slug).slice(0, 12);
const descricao = `Consórcio em ${cid.nome} (${e.uf}) sem juros e sem entrada. Imóveis, veículos, motos, caminhões e serviços. Simulação gratuita em 2 minutos.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Consórcio em ${cid.nome}`,
  description: descricao,
  provider: { '@type': 'Organization', name: site.nome, url: site.url },
  areaServed: { '@type': 'City', name: cid.nome, containedInPlace: { '@type': 'State', name: e.nome } },
};
---

<BaseLayout title={`Consórcio em ${cid.nome} — ${e.uf}. Simule Grátis | ${site.nome}`} description={descricao}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <PageHero
    label={`${cid.nome} · ${e.uf}`}
    titulo={`Consórcio em ${cid.nome} Sem Juros e Sem Entrada`}
    texto={`Simule seu consórcio em ${cid.nome} comparando planos de 37 administradoras autorizadas pelo Banco Central. Atendimento digital ou presencial.`}
    imagem="/images/brazil-city.webp"
    cta={`Simular em ${cid.nome}`}
    trilha={[
      { rotulo: 'Início', href: '/' },
      { rotulo: 'Localidades', href: '/localidades' },
      { rotulo: e.nome, href: `/consorcio-em-${e.slug}` },
      { rotulo: cid.nome },
    ]}
  />

  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <p class="section-label">Consórcio em {cid.nome}</p>
      <h2 class="font-heading font-bold text-3xl text-primary-900 mb-6">
        Por que o consórcio é uma boa escolha em {cid.nome}
      </h2>
      <div class="space-y-5 text-primary-700 leading-relaxed">
        <p>
          Moradores de {cid.nome} contam com atendimento completo da {site.nome}: simulação gratuita, comparativo entre
          administradoras e acompanhamento até a contemplação. Todo o processo pode ser feito digitalmente.
        </p>
        <p>
          Sem juros bancários e sem entrada obrigatória, o consórcio costuma resultar em parcelas até 50% menores que um
          financiamento com o mesmo valor de crédito. A contemplação acontece por sorteio ou lance, nas assembleias
          mensais do grupo.
        </p>
        <p>
          As modalidades disponíveis em {cid.nome} cobrem imóveis, automóveis, motos, caminhões, veículos pesados,
          máquinas agrícolas, embarcações, aeronaves e serviços.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-px bg-primary-200 mt-12">
        <div class="bg-white p-6">
          <p class="font-heading text-3xl font-bold text-primary-900 mb-1">R$ 0</p>
          <p class="text-primary-600 text-xs uppercase tracking-wider">De juros bancários</p>
        </div>
        <div class="bg-white p-6">
          <p class="font-heading text-3xl font-bold text-primary-900 mb-1">37</p>
          <p class="text-primary-600 text-xs uppercase tracking-wider">Administradoras</p>
        </div>
        <div class="bg-white p-6">
          <p class="font-heading text-3xl font-bold text-primary-900 mb-1">100%</p>
          <p class="text-primary-600 text-xs uppercase tracking-wider">Digital</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-primary-50">
    <div class="max-w-7xl mx-auto px-6">
      <p class="section-label">Modalidades</p>
      <h2 class="font-heading font-bold text-3xl text-primary-900 mb-12">Consórcios disponíveis em {cid.nome}</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-px bg-primary-200 list-none p-0 m-0">
        {
          consorciosDestaque.map((c) => (
            <li class="bg-white">
              <a class="group block p-8 h-full transition-colors duration-500 hover:bg-primary-900" href={`/${c.slug}`}>
                <span class="w-12 h-12 border border-primary-200 flex items-center justify-center mb-5 transition-all duration-500 group-hover:bg-accent group-hover:border-accent">
                  <Icon name={c.icone} class="w-5 h-5 text-primary-900 transition-colors duration-500 group-hover:text-white" />
                </span>
                <h3 class="font-heading text-xl font-bold text-primary-900 mb-2 group-hover:text-white transition-colors duration-300">
                  {c.nome}
                </h3>
                <p class="text-primary-700 text-sm leading-relaxed group-hover:text-white transition-colors duration-300">
                  {c.resumo}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    outras.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <p class="section-label">Perto de {cid.nome}</p>
          <h2 class="font-heading font-bold text-2xl text-primary-900 mb-8">Outras cidades de {e.nome}</h2>
          <div class="flex flex-wrap gap-x-8 gap-y-3">
            {outras.map((o) => (
              <a
                class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                href={`/consorcio-em-${e.slug}/${o.slug}`}
              >
                {o.nome}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FaqLista perguntas={faq} titulo={`Dúvidas sobre consórcio em ${cid.nome}`} />
  <CtaFinal
    titulo={`Simule seu consórcio em ${cid.nome}`}
    texto={`Sem juros, sem entrada obrigatória. Atendimento em ${cid.nome} e em toda a região.`}
  />
</BaseLayout>
