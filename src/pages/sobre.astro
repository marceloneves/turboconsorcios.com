---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Depoimentos from '../components/Depoimentos.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { site, numeros } from '../data/site';

const valores = [
  {
    icone: 'scale',
    titulo: 'Comparação antes da venda',
    texto:
      'Somos independentes. Comparamos as condições de 37 administradoras e mostramos o quadro completo, inclusive quando a melhor opção não é a mais rentável para nós.',
  },
  {
    icone: 'shield',
    titulo: 'Só administradoras autorizadas',
    texto:
      'Trabalhamos exclusivamente com administradoras autorizadas e fiscalizadas pelo Banco Central, conforme a Lei 11.795/2008.',
  },
  {
    icone: 'fileSearch',
    titulo: 'Transparência no custo total',
    texto:
      'Taxa de administração, fundo de reserva, seguro e reajuste: você vê o custo efetivo antes de assinar qualquer coisa.',
  },
  {
    icone: 'users',
    titulo: 'Acompanhamento até a contemplação',
    texto:
      'A relação não termina na adesão. Acompanhamos assembleias, estratégias de lance e a liberação da carta de crédito.',
  },
];

const marcos = [
  { ano: '2010', titulo: 'Fundação', texto: 'Início das operações com foco em consórcio imobiliário no Sudeste.' },
  { ano: '2014', titulo: 'Expansão de modalidades', texto: 'Entrada em veículos, motos e caminhões, atendendo autônomos e transportadoras.' },
  { ano: '2018', titulo: 'Atendimento nacional', texto: 'Operação 100% digital, cobrindo todas as regiões do país.' },
  { ano: '2022', titulo: 'Agronegócio e serviços', texto: 'Máquinas agrícolas, embarcações, aeronaves e cartas de serviços.' },
  { ano: 'Hoje', titulo: '50 mil clientes ativos', texto: '37 administradoras parceiras e presença nas 5.570 cidades brasileiras.' },
];
---

<BaseLayout
  title={`Sobre a ${site.nome} — Quem Somos e Como Trabalhamos`}
  description={`Conheça a ${site.nome}: rede independente de consórcios com 37 administradoras parceiras, 50 mil clientes ativos e atendimento em todo o Brasil.`}
>
  <PageHero
    label="Quem Somos"
    titulo={`A ${site.nome} existe para você comparar antes de contratar`}
    texto="Somos uma rede independente de consórcios. Não representamos uma única administradora — comparamos o mercado e apresentamos as condições reais de cada grupo."
    imagem="/images/handshake.webp"
    cta="Falar com um Especialista"
    trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Sobre Nós' }]}
  />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="section-label">Nossa História</p>
        <h2 class="font-heading font-bold text-3xl text-primary-900 mb-6">
          Quinze anos transformando planejamento em patrimônio
        </h2>
        <div class="space-y-5 text-primary-700 leading-relaxed">
          <p>
            A {site.nome} nasceu em {site.desde} de uma constatação simples: a maior parte das pessoas contrata consórcio
            sem comparar. Escolhe a primeira administradora que aparece, aceita a taxa oferecida e descobre o custo real
            só depois de assinar.
          </p>
          <p>
            Nosso trabalho é inverter essa ordem. Antes de qualquer contratação, apresentamos o comparativo entre
            administradoras — taxa de administração, fundo de reserva, seguro, prazo, regras de lance — para que a
            decisão seja informada.
          </p>
          <p>
            Hoje somos mais de 50 mil clientes ativos, 37 administradoras parceiras e cobertura nas 5.570 cidades
            brasileiras, com atendimento digital ou presencial.
          </p>
        </div>
      </div>
      <div class="relative">
        <img
          src="/images/finance.webp"
          alt={`Equipe da ${site.nome} analisando planos de consórcio`}
          class="w-full h-[480px] object-cover"
          loading="lazy"
        />
        <div class="absolute -bottom-6 -left-6 bg-accent-600 text-white px-8 py-5 shadow-2xl hidden md:block">
          <p class="font-heading text-4xl font-bold">15+</p>
          <p class="text-sm">Anos de mercado</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-primary-900">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 lg:grid-cols-4 gap-10">
      {
        numeros.map((n) => (
          <figure class="border-l-2 border-accent pl-6 m-0">
            <p class="font-heading text-4xl md:text-5xl font-bold text-white mb-2">{n.valor}</p>
            <figcaption class="text-primary-100 text-sm uppercase tracking-wider font-medium">{n.rotulo}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="py-24 bg-primary-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="section-label">Como Trabalhamos</p>
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-primary-900 mb-4">Quatro compromissos inegociáveis</h2>
        <p class="text-primary-700 text-lg max-w-2xl mx-auto">
          O que orienta cada simulação, cada comparativo e cada contrato que passa pelas nossas mãos.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-primary-200">
        {
          valores.map((v) => (
            <div class="bg-white p-8">
              <span class="w-12 h-12 bg-primary-50 border border-primary-200 flex items-center justify-center mb-5">
                <Icon name={v.icone} class="w-5 h-5 text-accent" />
              </span>
              <h3 class="font-heading font-bold text-lg text-primary-900 mb-2">{v.titulo}</h3>
              <p class="text-primary-700 text-sm leading-relaxed">{v.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <p class="section-label">Linha do Tempo</p>
      <h2 class="font-heading font-bold text-3xl text-primary-900 mb-12">Da primeira carta de crédito à cobertura nacional</h2>
      <ol class="list-none p-0 m-0 border-l-2 border-primary-100 pl-8 space-y-10">
        {
          marcos.map((m) => (
            <li class="relative">
              <span class="absolute -left-[41px] top-1 w-4 h-4 bg-accent border-4 border-white" />
              <p class="text-xs uppercase tracking-[0.2em] font-semibold text-accent-700 mb-1">{m.ano}</p>
              <h3 class="font-heading font-bold text-lg text-primary-900 mb-1">{m.titulo}</h3>
              <p class="text-primary-700 text-sm leading-relaxed">{m.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Depoimentos limite={3} />
  <CtaFinal titulo="Converse com quem compara o mercado inteiro" texto="Simulação gratuita, sem compromisso e com o comparativo de 37 administradoras." />
</BaseLayout>
