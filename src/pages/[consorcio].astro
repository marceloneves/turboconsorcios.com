---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqLista from '../components/FaqLista.astro';
import Depoimentos from '../components/Depoimentos.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { consorcios } from '../data/consorcios';
import { faq } from '../data/faq';
import { estadosPorRegiao } from '../data/estados';
import { site, whatsappUrl } from '../data/site';

export function getStaticPaths() {
  return consorcios.map((c) => ({ params: { consorcio: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const relacionados = consorcios.filter((o) => o.categoria === c.categoria && o.slug !== c.slug).slice(0, 6);

const passos = [
  { titulo: 'Simulação gratuita', texto: `Você informa o valor desejado e o prazo. Comparamos os planos de ${c.nome.toLowerCase()} disponíveis.` },
  { titulo: 'Comparativo de administradoras', texto: 'Analisamos taxa de administração, fundo de reserva, seguro e regras de lance de cada grupo.' },
  { titulo: 'Adesão ao grupo', texto: 'Assinatura digital do contrato. Você já concorre à contemplação na primeira assembleia.' },
  { titulo: 'Contemplação e compra', texto: 'Por sorteio ou lance. Com a carta em mãos, você negocia à vista e ganha poder de desconto.' },
];

const beneficios = [
  'Sem juros bancários — apenas taxa de administração',
  'Sem entrada obrigatória para começar',
  'Carta de crédito com poder de compra à vista',
  'Parcelas até 50% menores que o financiamento',
  'Possibilidade de lance para antecipar a contemplação',
  'Grupos autorizados e fiscalizados pelo Banco Central',
];

const faqLocal = [
  {
    pergunta: `Qual o valor da carta de crédito no ${c.nome.toLowerCase()}?`,
    resposta: `As cartas de crédito para ${c.nome.toLowerCase()} vão de ${c.credito}. O valor ideal depende da sua capacidade de pagamento mensal e do prazo escolhido — a simulação gratuita mostra as faixas disponíveis para o seu perfil.`,
  },
  ...faq,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.nome,
  description: c.descricaoSeo,
  provider: { '@type': 'Organization', name: site.nome, url: site.url },
  areaServed: { '@type': 'Country', name: 'Brasil' },
};
---

<BaseLayout title={`${c.titulo} | ${site.nome}`} description={c.descricaoSeo}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <PageHero
    label="Consórcio Sem Juros"
    titulo={c.h1}
    texto={c.resumo}
    imagem={c.imagem}
    cta={c.cta}
    trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Consórcios', href: '/mapa-do-site' }, { rotulo: c.nome }]}
  />

  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2">
        <p class="section-label">Como Funciona</p>
        <h2 class="font-heading font-bold text-3xl text-primary-900 mb-6">
          {c.nome}: planejamento no lugar de juros
        </h2>
        <div class="space-y-5 text-primary-700 leading-relaxed">
          <p>
            O {c.nome.toLowerCase()} reúne pessoas com o mesmo objetivo em um grupo administrado por uma empresa
            autorizada pelo Banco Central. Todo mês, cada participante paga uma parcela e o grupo contempla um ou mais
            integrantes por sorteio ou lance.
          </p>
          <p>
            Não existem juros nessa operação — você paga apenas a taxa de administração, diluída ao longo de todo o
            prazo. É isso que torna a parcela do consórcio significativamente menor que a de um financiamento com o
            mesmo valor de crédito.
          </p>
          <p>
            Quando é contemplado, você recebe uma carta de crédito de {c.credito} e compra à vista. Na prática, isso
            abre espaço para negociar descontos que simplesmente não existem quando a compra é financiada.
          </p>
        </div>

        <div class="mt-12 space-y-8">
          {
            passos.map((p, i) => (
              <div class="flex gap-6 items-start">
                <span class="shrink-0 w-12 h-12 bg-primary-50 border border-primary-200 flex items-center justify-center font-heading font-bold text-primary-900">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-heading font-bold text-lg text-primary-900 mb-1">{p.titulo}</h3>
                  <p class="text-primary-700 text-sm leading-relaxed">{p.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="bg-primary-900 p-8 sticky top-28">
          <p class="text-xs uppercase tracking-[0.2em] font-semibold text-accent-400 mb-3">Carta de crédito</p>
          <p class="font-heading text-3xl font-bold text-white mb-6">{c.credito}</p>
          <ul class="space-y-3 list-none p-0 mb-8">
            {
              beneficios.map((b) => (
                <li class="flex gap-3 items-start">
                  <Icon name="check" class="w-4 h-4 text-accent-400 mt-0.5 shrink-0" />
                  <span class="text-primary-100 text-sm leading-relaxed">{b}</span>
                </li>
              ))
            }
          </ul>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full text-center">
            {c.cta}
          </a>
          <p class="text-white/50 text-xs mt-4 text-center">Simulação gratuita e sem compromisso</p>
        </div>
      </aside>
    </div>
  </section>

  {
    relacionados.length > 0 && (
      <section class="py-24 bg-primary-50">
        <div class="max-w-7xl mx-auto px-6">
          <p class="section-label">Modalidades Relacionadas</p>
          <h2 class="font-heading font-bold text-3xl text-primary-900 mb-12">Outras opções na mesma categoria</h2>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-px bg-primary-200 list-none p-0 m-0">
            {relacionados.map((r) => (
              <li class="bg-white">
                <a class="group block p-8 h-full transition-colors duration-500 hover:bg-primary-900" href={`/${r.slug}`}>
                  <span class="w-12 h-12 border border-primary-200 flex items-center justify-center mb-5 transition-all duration-500 group-hover:bg-accent group-hover:border-accent">
                    <Icon name={r.icone} class="w-5 h-5 text-primary-900 transition-colors duration-500 group-hover:text-white" />
                  </span>
                  <h3 class="font-heading text-xl font-bold text-primary-900 mb-2 group-hover:text-white transition-colors duration-300">
                    {r.nome}
                  </h3>
                  <p class="text-primary-700 text-sm leading-relaxed group-hover:text-white transition-colors duration-300">
                    {r.resumo}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Depoimentos limite={3} titulo={`Quem já contratou ${c.nome.toLowerCase()}`} />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <p class="section-label">Cobertura Nacional</p>
      <h2 class="font-heading font-bold text-3xl text-primary-900 mb-4">
        {c.nome} em todo o Brasil
      </h2>
      <p class="text-primary-700 mb-12 max-w-2xl">
        Atendemos as 5.570 cidades brasileiras, de forma 100% digital ou presencial. Escolha o seu estado:
      </p>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-x-8 gap-y-3">
        {
          estadosPorRegiao.flatMap((g) =>
            g.estados.map((e) => (
              <a
                class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                href={`/consorcio-em-${e.slug}`}
              >
                {e.nome}
              </a>
            ))
          )
        }
      </div>
    </div>
  </section>

  <FaqLista perguntas={faqLocal} titulo={`Dúvidas sobre ${c.nome.toLowerCase()}`} />

  <CtaFinal titulo={`Simule seu ${c.nome.toLowerCase()} agora`} texto={c.resumo} cta={c.cta} />
</BaseLayout>
