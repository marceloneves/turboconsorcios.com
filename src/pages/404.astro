---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Página não encontrada | ${site.nome}`} description="A página que você procura não existe ou foi movida.">
  <section class="py-32 bg-white">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="section-label">Erro 404</p>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-primary-900 mb-6">Essa página não existe</h1>
      <p class="text-primary-700 text-lg mb-10">
        O endereço pode ter mudado ou o link está incorreto. Use os atalhos abaixo para continuar.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">
          <span class="flex items-center gap-2">Ir para a Home<Icon name="arrowRight" class="w-4 h-4" /></span>
        </a>
        <a
          href="/mapa-do-site"
          class="inline-block border-2 border-primary-900 text-primary-900 px-8 py-4 text-sm font-semibold uppercase tracking-wider hover:bg-primary-900 hover:text-white transition-colors duration-300"
          >Ver o mapa do site</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
