---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { consorcios } from '../data/consorcios';
import { estados } from '../data/estados';
import { site } from '../data/site';

const categorias = [
  { chave: 'imoveis', rotulo: 'Imóveis' },
  { chave: 'veiculos', rotulo: 'Veículos' },
  { chave: 'agro', rotulo: 'Agronegócio' },
  { chave: 'servicos', rotulo: 'Serviços' },
  { chave: 'lazer', rotulo: 'Náutico e Aéreo' },
] as const;
---

<BaseLayout
  title={`Mapa do Site | ${site.nome}`}
  description={`Todas as páginas da ${site.nome}: modalidades de consórcio, estados, cidades atendidas e conteúdos institucionais.`}
>
  <PageHero
    label="Navegação"
    titulo="Mapa do site"
    texto="Todas as páginas em um só lugar: modalidades de consórcio, cobertura por estado e cidade, blog e conteúdos institucionais."
    imagem="/images/office.webp"
    cta="Simular Gratuitamente"
    trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Mapa do Site' }]}
  />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 space-y-16">
      <div>
        <h2 class="font-heading font-bold text-2xl text-primary-900 mb-6 pb-4 border-b border-primary-100">
          Institucional
        </h2>
        <ul class="grid md:grid-cols-3 gap-3 list-none p-0">
          <li><a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href="/">Início</a></li>
          <li><a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href="/sobre">Sobre Nós</a></li>
          <li><a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href="/contato">Contato</a></li>
          <li><a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href="/blog">Blog</a></li>
          <li>
            <a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href="/localidades">Localidades</a>
          </li>
        </ul>
      </div>

      {
        categorias.map((cat) => {
          const lista = consorcios.filter((c) => c.categoria === cat.chave);
          return (
            lista.length > 0 && (
              <div>
                <h2 class="font-heading font-bold text-2xl text-primary-900 mb-6 pb-4 border-b border-primary-100">
                  Consórcio de {cat.rotulo}
                </h2>
                <ul class="grid md:grid-cols-3 gap-3 list-none p-0">
                  {lista.map((c) => (
                    <li>
                      <a class="text-primary-700 text-sm hover:text-accent-600 transition-colors" href={`/${c.slug}`}>
                        {c.nome}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          );
        })
      }

      <div>
        <h2 class="font-heading font-bold text-2xl text-primary-900 mb-6 pb-4 border-b border-primary-100">
          Consórcio por estado
        </h2>
        <ul class="grid md:grid-cols-3 gap-3 list-none p-0">
          {
            estados.map((e) => (
              <li>
                <a
                  class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                  href={`/consorcio-em-${e.slug}`}
                >
                  Consórcio em {e.nome}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-bold text-2xl text-primary-900 mb-6 pb-4 border-b border-primary-100">
          Consórcio por cidade
        </h2>
        <ul class="grid md:grid-cols-4 gap-3 list-none p-0">
          {
            estados.flatMap((e) =>
              e.cidades.map((c) => (
                <li>
                  <a
                    class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                    href={`/consorcio-em-${e.slug}/${c.slug}`}
                  >
                    {c.nome} — {e.uf}
                  </a>
                </li>
              ))
            )
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaFinal />
</BaseLayout>
