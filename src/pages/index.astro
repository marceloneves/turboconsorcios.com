        </h2>
      </div>
      <div class="divide-y divide-primary-100 border-y border-primary-100">
        {
          faq.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex items-center justify-between gap-6 py-6 cursor-pointer list-none">
                <h3 class="font-heading font-semibold text-lg text-primary-900">{f.pergunta}</h3>
                <Icon
