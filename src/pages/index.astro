        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
        {
          estadosPorRegiao.map((g) => (
            <div class="bg-white/5 border border-white/10 p-6 backdrop-blur-sm">
              <h3 class="font-heading font-bold text-lg text-white mb-4 flex items-center gap-2">
                <Icon name="mapPin" class="w-4 h-4 text-accent-400" />
                {g.regiao}
              </h3>
              <ul class="space-y-2 list-none p-0">
                {g.estados.map((e) => (
                  <li>
                    <a class="text-white/80 text-sm hover:text-accent transition-colors" href={`/consorcio-em-${e.slug}`}>
                      {e.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="text-center mt-14">
        <a href="/localidades" class="btn-outline">
          <span class="flex items-center gap-2">Simule Na Sua Cidade<Icon name="arrowRight" class="w-4 h-4" /></span>
        </a>
