---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { estadosPorRegiao, estados, totalCidades } from '../data/estados';
import { site } from '../data/site';
---

<BaseLayout
  title={`Localidades — Consórcio em Todo o Brasil | ${site.nome}`}
  description={`Consórcio sem juros nos ${estados.length} estados e no Distrito Federal. Encontre a página da sua cidade e simule gratuitamente.`}
>
  <PageHero
    label="Cobertura Nacional"
    titulo="Consórcio sem juros em todo o Brasil"
    texto={`Atendemos as 5.570 cidades brasileiras. Navegue por estado e encontre as condições disponíveis na sua região — ${totalCidades} cidades com página dedicada.`}
    imagem="/images/brazil-city.webp"
    cta="Simular na Minha Cidade"
    trilha={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Localidades' }]}
  />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 space-y-16">
      {
        estadosPorRegiao.map((g) => (
          <div>
            <h2 class="font-heading font-bold text-2xl text-primary-900 mb-8 flex items-center gap-3 pb-4 border-b border-primary-100">
              <Icon name="mapPin" class="w-5 h-5 text-accent" />
              Região {g.regiao}
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {g.estados.map((e) => (
                <div>
                  <a
                    class="font-heading font-bold text-lg text-primary-900 hover:text-accent-600 transition-colors"
                    href={`/consorcio-em-${e.slug}`}
                  >
                    {e.nome} <span class="text-primary-400 font-normal text-sm">({e.uf})</span>
                  </a>
                  <ul class="mt-3 space-y-1.5 list-none p-0">
                    {e.cidades.map((c) => (
                      <li>
                        <a
                          class="text-primary-700 text-sm hover:text-accent-600 transition-colors"
                          href={`/consorcio-em-${e.slug}/${c.slug}`}
                        >
                          {c.nome}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <CtaFinal titulo="Não achou sua cidade?" texto="Atendemos todos os 5.570 municípios brasileiros. Fale com um especialista e simule gratuitamente." />
</BaseLayout>
