---
import Icon from './Icon.astro';
import type { Pergunta } from '../data/faq';

interface Props {
  perguntas: Pergunta[];
  titulo?: string;
  label?: string;
}
const { perguntas, titulo = 'Perguntas Frequentes Sobre Consórcio', label = 'Tire Suas Dúvidas' } = Astro.props;
---

<section class="py-24 md:py-32 bg-white" id="faq">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="section-label">{label}</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-primary-900">{titulo}</h2>
    </div>
    <div class="divide-y divide-primary-100 border-y border-primary-100">
      {
        perguntas.map((f, i) => (
          <details class="group" open={i === 0}>
            <summary class="flex items-center justify-between gap-6 py-6 cursor-pointer list-none">
              <h3 class="font-heading font-semibold text-lg text-primary-900">{f.pergunta}</h3>
              <Icon
                name="chevronDown"
                class="w-5 h-5 text-accent shrink-0 transition-transform duration-300 group-open:rotate-180"
              />
            </summary>
            <p class="text-primary-700 leading-relaxed pb-6 pr-10">{f.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
