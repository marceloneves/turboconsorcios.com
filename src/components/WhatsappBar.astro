---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com um especialista no WhatsApp"
  class="fixed bottom-5 right-5 z-40 w-14 h-14 bg-[#25D366] hover:bg-[#1da851] text-white rounded-full shadow-2xl flex items-center justify-center transition-colors duration-300"
>
  <Icon name="whatsapp" class="w-8 h-8" />
</a>
