---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  class="fixed right-5 bottom-5 z-[90] w-14 h-14 rounded-full bg-[#25d366] text-white shadow-card hidden md:flex items-center justify-center transition-transform hover:-translate-y-1"
>
  <span class="absolute inset-0 rounded-full bg-[#25d366] animate-ping opacity-30 motion-reduce:hidden" aria-hidden="true"></span>
  <Icon name="whatsapp" class="relative w-7 h-7" />
</a>
