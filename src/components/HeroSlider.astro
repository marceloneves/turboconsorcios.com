---
/* main-slider do Fixnix: slides em crossfade, zoom lento da foto, textos que entram de cima/baixo */
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';

type Slide = { imagem: string; srcset?: string; tagline: string; titulo: string; texto: string; cta: string };
interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;
---

<section class="relative isolate bg-ink overflow-hidden" aria-roledescription="carrossel" aria-label="Destaques" data-hero>
  <div class="relative min-h-[620px] lg:min-h-[760px]">
    {
      slides.map((s, i) => (
        <div
          class:list={['hero-slide absolute inset-0 flex items-center', i === 0 && 'is-active']}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${slides.length}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <div class="absolute inset-0 -z-10 overflow-hidden bg-ink">
            <img
              src={s.imagem}
              srcset={s.srcset}
              sizes="100vw"
              alt=""
              class="hero-slide-img w-full h-full object-cover"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
            <div class="absolute inset-0 bg-gradient-to-r from-ink-950/90 via-ink/60 to-ink/10" />
          </div>
          <div class="container-x w-full py-28">
            <div class="max-w-[720px]">
              <p class="hero-anim-top inline-flex items-center gap-3 font-heading text-[16px] md:text-[18px] font-semibold uppercase tracking-[0.08em] text-brand-300">
                <span class="w-10 h-[2px] bg-brand-300" aria-hidden="true" />
                {s.tagline}
              </p>
              {i === 0 ? (
                <h1 class="hero-anim-top mt-5 font-heading text-white font-bold text-[40px] leading-[48px] md:text-[65px] md:leading-[75px]">
                  {s.titulo}
                </h1>
              ) : (
                <p class="hero-anim-top mt-5 font-heading text-white font-bold text-[40px] leading-[48px] md:text-[65px] md:leading-[75px]">
                  {s.titulo}
                </p>
              )}
              <p class="hero-anim-bottom mt-6 text-white/85 text-[18px] leading-[30px] md:text-[20px] max-w-[600px]">{s.texto}</p>
              <div class="hero-anim-bottom mt-10 flex flex-wrap gap-4">
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="thm-btn" tabindex={i === 0 ? undefined : -1}>
                  {s.cta}
                  <Icon name="arrowRight" class="w-4 h-4" />
                </a>
                <a href="#consorcios" class="thm-btn thm-btn-light" tabindex={i === 0 ? undefined : -1}>
                  Ver Consórcios
                </a>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Navegação (main-slider__nav) -->
  <div class="absolute inset-x-0 bottom-8 lg:bottom-auto lg:top-1/2 lg:-translate-y-1/2 pointer-events-none">
    <div class="container-x flex lg:flex-col lg:items-end gap-3 justify-end">
      <button
        type="button"
        data-anterior
        class="pointer-events-auto w-[50px] h-[50px] rounded-full border-2 border-white/25 text-white/50 flex items-center justify-center transition-colors hover:border-white hover:text-white"
        aria-label="Slide anterior"
      >
        <Icon name="arrowRight" class="w-5 h-5 rotate-180" />
      </button>
      <button
        type="button"
        data-proximo
        class="pointer-events-auto w-[50px] h-[50px] rounded-full border-2 border-white/25 text-white/50 flex items-center justify-center transition-colors hover:border-white hover:text-white"
        aria-label="Próximo slide"
      >
        <Icon name="arrowRight" class="w-5 h-5" />
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero-slide')];
    if (slides.length < 2) return;
    let atual = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const ir = (n: number) => {
      slides[atual].classList.remove('is-active');
      slides[atual].setAttribute('aria-hidden', 'true');
      slides[atual].querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
      atual = (n + slides.length) % slides.length;
      slides[atual].classList.add('is-active');
      slides[atual].setAttribute('aria-hidden', 'false');
      slides[atual].querySelectorAll('a').forEach((a) => a.removeAttribute('tabindex'));
      slides[atual].querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
    };
    const iniciar = () => {
      clearInterval(timer);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => ir(atual + 1), 7000);
    };
    hero.querySelector('[data-anterior]')?.addEventListener('click', () => (ir(atual - 1), iniciar()));
    hero.querySelector('[data-proximo]')?.addEventListener('click', () => (ir(atual + 1), iniciar()));
    hero.addEventListener('focusin', () => clearInterval(timer));
    hero.addEventListener('focusout', iniciar);
    iniciar();
  });
</script>
