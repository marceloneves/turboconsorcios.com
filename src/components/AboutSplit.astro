---
/* about-one: foto com brilho diagonal e caixa laranja "nosso objetivo"; à direita título, texto e pontos em pílula */
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import type { Item } from '../data/conteudo';

interface Props {
  tagline: string;
  titulo: string;
  imagem: string;
  srcset?: string;
  alt: string;
  objetivoRotulo: string;
  objetivo: string;
  pontos: Item[];
  cta?: { rotulo: string; href: string };
}
const { tagline, titulo, imagem, srcset, alt, objetivoRotulo, objetivo, pontos, cta } = Astro.props;
---

<section class="section-y bg-white overflow-hidden" id="sobre">
  <div class="container-x grid gap-14 lg:grid-cols-2 items-center">
    <div class="lg:mr-[52px]">
      <div
        class="group relative overflow-hidden rounded-[8px] before:absolute before:top-0 before:-left-full before:z-[2] before:w-1/2 before:h-full before:bg-gradient-to-r before:from-brand/70 before:to-brand/30 before:skew-x-[20deg] hover:before:left-[150%] before:transition-all before:duration-1000"
      >
        <img src={imagem} srcset={srcset} sizes="(max-width: 1024px) 100vw, 50vw" alt={alt} class="w-full h-[420px] lg:h-[560px] object-cover" loading="lazy" />
        <div class="absolute bottom-0 left-0 right-[20%] sm:right-[168px] z-[3] bg-brand rounded-tr-[8px] rounded-bl-[8px] px-[30px] pt-[40px] pb-[38px]">
          <p class="font-heading text-white text-[16px] font-semibold uppercase pb-3 mb-3 border-b border-white/30">{objetivoRotulo}</p>
          <p class="font-heading text-white text-[24px] leading-[34px] lg:text-[28px] lg:leading-[38px] font-semibold">{objetivo}</p>
        </div>
      </div>
    </div>

    <div>
      <SectionTitle tagline={tagline} titulo={titulo} class="!mb-[30px]" />
      <div class="space-y-4"><slot /></div>
      <ul class="my-[40px] space-y-4">
        {
          pontos.map((p) => (
            <li class="group relative isolate flex items-center gap-5 p-[22px] rounded-l-[60px] bg-soft overflow-hidden before:absolute before:inset-0 before:-z-10 before:rounded-l-[60px] before:bg-brand before:scale-x-0 before:origin-left before:transition-transform before:duration-500 hover:before:scale-x-100">
              <span class="w-[60px] h-[60px] shrink-0 rounded-full bg-white shadow-card flex items-center justify-center text-brand">
                <Icon name={p.icone} class="w-7 h-7" />
              </span>
              <span>
                <span class="block font-heading text-[20px] leading-[30px] font-semibold text-ink group-hover:text-white transition-colors">{p.titulo}</span>
                <span class="block text-[15px] leading-[26px] group-hover:text-white transition-colors">{p.texto}</span>
              </span>
            </li>
          ))
        }
      </ul>
      {cta && <a href={cta.href} class="thm-btn">{cta.rotulo}</a>}
    </div>
  </div>
</section>
