---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../data/site';
import { menuTopo, menuPrincipal, menuDestaque } from '../data/navegacao';

const path = Astro.url.pathname;
const ativo = (g: (typeof menuPrincipal)[number]) =>
  path.startsWith(g.url) || g.colunas.some((c) => path.startsWith(c.url) || c.links.some((l) => l.url === path));
---

<header class="relative z-[99]">
  <!-- Barra superior (main-menu-two__top) -->
  <div class="hidden md:block bg-ink text-white/80 text-[14px]">
    <div class="container-x flex items-center justify-between gap-6 py-2.5">
      <ul class="flex items-center gap-7">
        <li class="flex items-center gap-2">
          <Icon name="mail" class="w-4 h-4 text-brand" />
          <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
        </li>
        <li class="hidden lg:flex items-center gap-2">
          <Icon name="phone" class="w-4 h-4 text-brand" />
          <a href={site.telefoneLink} class="hover:text-white">{site.telefone}</a>
        </li>
      </ul>
      <ul class="flex items-center gap-6">
        {
          menuTopo.map((l) => (
            <li>
              <a href={l.url} class="hover:text-white">
                {l.rotulo}
              </a>
            </li>
          ))
        }
        <li>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-white font-semibold hover:text-brand-300">
            <Icon name="whatsapp" class="w-4 h-4" />WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Menu principal com mega menus -->
  <div id="barra-principal" class="relative bg-white border-b border-line z-[99] w-full">
    <div class="container-x flex items-center justify-between gap-6 py-4 xl:py-0">
      <Logo />

      <nav class="hidden xl:block" aria-label="Principal">
        <ul class="flex items-center gap-5">
          <li>
            <a
              href="/"
              class:list={[
                'block py-[34px] whitespace-nowrap font-heading text-[15px] font-semibold transition-colors',
                path === '/' ? 'text-brand' : 'text-ink hover:text-brand',
              ]}>Início</a
            >
          </li>
          {
            menuPrincipal.map((g) => (
              <li class="group">
                <a
                  href={g.url}
                  aria-haspopup="true"
                  class:list={[
                    'flex items-center gap-1 py-[34px] whitespace-nowrap font-heading text-[15px] font-semibold transition-colors',
                    ativo(g) ? 'text-brand' : 'text-ink hover:text-brand',
                  ]}
                >
                  {g.rotulo}
                  <Icon name="chevronDown" class="w-3.5 h-3.5" />
                </a>
                <div class="absolute left-0 right-0 top-full bg-white shadow-card border-t-2 border-brand opacity-0 invisible translate-y-3 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-300">
                  <div class="container-x py-8 grid grid-cols-4 gap-x-8 gap-y-7 max-h-[70vh] overflow-y-auto">
                    {g.colunas.map((c) => (
                      <div>
                        <p class="font-heading text-[14px] uppercase tracking-[0.08em] font-semibold text-brand mb-2.5">{c.titulo}</p>
                        <ul class="space-y-0.5">
                          {c.links.map((l) => (
                            <li>
                              <a href={l.url} class="block text-[14px] leading-6 text-ink hover:text-brand">
                                {l.rotulo}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-4">
        {
          menuDestaque && (
            <a href={menuDestaque.url} class="thm-btn hidden sm:inline-flex whitespace-nowrap">
              {menuDestaque.rotulo}
            </a>
          )
        }
        <button
          id="menu-toggle"
          type="button"
          class="xl:hidden w-11 h-11 flex items-center justify-center text-ink"
          aria-label="Abrir menu"
          aria-controls="menu-mobile"
          aria-expanded="false"
        >
          <Icon name="menu" class="w-7 h-7" />
        </button>
      </div>
    </div>
  </div>
  <div id="barra-espaco" class="hidden"></div>

  <!-- Menu mobile: acordeão na mesma ordem do menu principal -->
  <div id="menu-mobile" class="fixed inset-0 z-[1000] invisible" aria-hidden="true">
    <div data-fechar class="absolute inset-0 bg-ink-950/70 opacity-0 transition-opacity duration-500"></div>
    <div class="painel absolute top-0 left-0 bottom-0 w-[340px] max-w-[88vw] bg-ink-950 text-white overflow-y-auto -translate-x-full transition-transform duration-500 px-6 py-7">
      <div class="flex items-center justify-between mb-8">
        <Logo claro />
        <button data-fechar type="button" class="w-10 h-10 flex items-center justify-center" aria-label="Fechar menu">
          <Icon name="x" class="w-6 h-6" />
        </button>
      </div>
      <ul class="divide-y divide-white/10 border-y border-white/10">
        <li>
          <a href="/" class="block py-3 font-heading text-[15px] font-semibold text-white hover:text-brand-300">Início</a>
        </li>
        {
          menuPrincipal.map((g) => (
            <li>
              <details class="accordion">
                <summary class="flex items-center justify-between py-3 font-heading text-[15px] font-semibold">
                  {g.rotulo}
                  <span class="accordion-icon w-7 h-7 rounded bg-brand flex items-center justify-center">
                    <Icon name="plus" class="w-4 h-4" />
                  </span>
                </summary>
                <div class="pb-4 pl-3 space-y-4">
                  <a href={g.url} class="block text-[14px] font-bold text-brand-300">
                    Ver tudo em {g.rotulo} →
                  </a>
                  {g.colunas.map((c) => (
                    <div>
                      <p class="text-[12px] uppercase tracking-[0.08em] font-semibold text-white/50 mb-1">{c.titulo}</p>
                      <ul>
                        {c.links.map((l) => (
                          <li>
                            <a href={l.url} class="block py-1 text-[14px] leading-5 text-white/85 hover:text-brand-300">
                              {l.rotulo}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 space-y-2 text-[14px]">
        {menuTopo.map((l) => <li><a href={l.url} class="hover:text-brand-300">{l.rotulo}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- Barra fixa inferior no celular: Simular e WhatsApp -->
  <div class="md:hidden fixed inset-x-0 bottom-0 z-[95] grid grid-cols-2 bg-white border-t border-line">
    {
      menuDestaque && (
        <a href={menuDestaque.url} class="flex items-center justify-center gap-2 py-3.5 bg-brand text-white font-bold text-[15px]">
          {menuDestaque.rotulo}
        </a>
      )
    }
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-3.5 bg-[#25d366] text-white font-bold text-[15px]">
      <Icon name="whatsapp" class="w-5 h-5" />WhatsApp
    </a>
  </div>
</header>

<script>
  // Menu mobile
  const menu = document.getElementById('menu-mobile')!;
  const toggle = document.getElementById('menu-toggle')!;
  const painel = menu.querySelector<HTMLElement>('.painel')!;
  const fundo = menu.querySelector<HTMLElement>('div[data-fechar]')!;
  const abrir = (aberto: boolean) => {
    menu.classList.toggle('invisible', !aberto);
    menu.setAttribute('aria-hidden', String(!aberto));
    painel.classList.toggle('-translate-x-full', !aberto);
    fundo.classList.toggle('opacity-0', !aberto);
    toggle.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => abrir(true));
  menu.querySelectorAll('[data-fechar]').forEach((el) => el.addEventListener('click', () => abrir(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && abrir(false));

  // Header fixo ao rolar (stricky-header)
  const barra = document.getElementById('barra-principal')!;
  const espaco = document.getElementById('barra-espaco')!;
  let limite = barra.offsetTop + barra.offsetHeight + 120;
  const aoRolar = () => {
    const fixo = window.scrollY > limite;
    if (fixo === barra.classList.contains('header-stuck')) return;
    espaco.style.height = fixo ? `${barra.offsetHeight}px` : '';
    espaco.classList.toggle('hidden', !fixo);
    barra.classList.toggle('header-stuck', fixo);
  };
  window.addEventListener('scroll', aoRolar, { passive: true });
  window.addEventListener('resize', () => {
    if (!barra.classList.contains('header-stuck')) limite = barra.offsetTop + barra.offsetHeight + 120;
  });
  aoRolar();
</script>
