---
/* faq-one: foto + título à esquerda, acordeão em cards navy à direita */
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import type { Pergunta } from '../data/faq';

interface Props {
  titulo: string;
  perguntas: Pergunta[];
}
const { titulo, perguntas } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((f) => ({
    '@type': 'Question',
    name: f.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: f.resposta },
  })),
};
---

<section class="section-y bg-ink-950" id="faq">
  <div class="container-x grid gap-14 lg:grid-cols-[5fr_7fr] items-start">
    <div>
      <SectionTitle tagline="Perguntas Frequentes" titulo={titulo} claro class="!mb-6" />
      <p class="text-white/70">Respostas diretas para as dúvidas que mais aparecem antes de contratar.</p>
      <div class="hidden lg:block relative mt-10 rounded-[8px] overflow-hidden bg-brand">
        <img src="/images/consultation-750.webp" alt="" class="w-full h-[300px] object-cover mix-blend-multiply opacity-90" loading="lazy" />
      </div>
    </div>
    <div class="space-y-5">
      {
        perguntas.map((f, i) => (
          <details class="accordion rounded-[4px] bg-ink-800 border border-transparent open:border-brand/60 transition-colors" open={i === 0} name="faq">
            <summary class="flex items-center justify-between gap-5 px-[25px] py-[16px]">
              <h3 class="font-body text-white text-[18px] leading-[28px] font-bold">{f.pergunta}</h3>
              <span class="accordion-icon w-8 h-8 shrink-0 rounded bg-brand text-white flex items-center justify-center">
                <Icon name="plus" class="w-4 h-4" />
              </span>
            </summary>
            <div class="px-[25px] pb-[22px] -mt-1">
              <p class="border-t border-white/15 pt-4 text-white/75 text-[15px] leading-[27px]">{f.resposta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
