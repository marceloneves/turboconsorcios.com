---
/* page-header do Fixnix: fundo navy com brilho laranja, título central e trilha (breadcrumb com dados estruturados) */
import { site } from '../data/site';

type Passo = { rotulo: string; href: string };
interface Props {
  titulo: string;
  trilha: Passo[];
}
const { titulo, trilha } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trilha.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.rotulo,
    item: new URL(p.href, site.url).href,
  })),
};
---

<section class="relative isolate bg-ink overflow-hidden">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgb(234_88_12/0.45),transparent_60%),radial-gradient(ellipse_at_bottom_left,rgb(234_88_12/0.2),transparent_55%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 opacity-[0.06] bg-[radial-gradient(circle_at_1px_1px,#fff_1px,transparent_0)] bg-[length:22px_22px]"
    aria-hidden="true"
  >
  </div>
  <div class="container-x py-[90px] lg:py-[130px] text-center">
    <h1 class="font-heading text-white text-[34px] leading-[44px] md:text-[50px] md:leading-[60px] font-bold max-w-4xl mx-auto">
      {titulo}
    </h1>
    <nav aria-label="Trilha de navegação" class="mt-6">
      <ol class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 bg-white/10 rounded px-6 py-2 text-[15px] font-semibold text-white">
        {
          trilha.map((p, i) => (
            <li class="flex items-center gap-3">
              {i > 0 && (
                <span class="text-brand-300" aria-hidden="true">
                  /
                </span>
              )}
              {i < trilha.length - 1 ? (
                <a href={p.href} class="hover:text-brand-300">
                  {p.rotulo}
                </a>
              ) : (
                <span aria-current="page" class="text-brand-300">
                  {p.rotulo}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
